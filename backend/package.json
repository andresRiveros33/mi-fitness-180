{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Mi Fitness 180",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "dotenv -e ../.env.local -e ../.env -- prisma generate",
    "db:migrate": "dotenv -e ../.env.local -e ../.env -- prisma migrate dev --name init",
    "db:push": "dotenv -e ../.env.local -e ../.env -- prisma db push",
    "db:seed": "dotenv -e ../.env.local -e ../.env -- prisma db seed",
    "db:reset": "dotenv -e ../.env.local -e ../.env -- prisma migrate reset --force --skip-seed",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "prisma": "^6.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "dotenv-cli": "^11.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
